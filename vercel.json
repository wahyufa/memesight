{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/dashboard",         "dest": "/memesight.html"    },
    { "src": "/memesight",         "dest": "/memesight.html"    },
    { "src": "/signd",             "dest": "/memesight.html"    },
    { "src": "/call",              "dest": "/call.html"         },
    { "src": "/token",             "dest": "/token.html"        },
    { "src": "/candidates",        "dest": "/candidates.html"   },
    { "src": "/docs",              "dest": "/index.html"        },
    { "src": "/brand-kit",         "dest": "/index.html"        },
    { "src": "/scanner-config.js", "dest": "/scanner-config.js" },
    { "src": "/(.*)",              "dest": "/index.html"        }
  ]
}
